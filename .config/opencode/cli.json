{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "transparent",
    "mode": "dark"
  },
  "plugins": [
    "opencode-quotes-plugin"
  ],
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "high",
    "image_preview": true,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "terminal": {
    "title": true,
    "copy": "manual"
  }
}
