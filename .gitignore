# Dotfiles whitelist — ignore everything by default, un-ignore only configuration files
*

# Un-ignore this gitignore
!.gitignore

# --- .config configuration dirs ---
!.config/
!.config/lazygit/
!.config/lazygit/**
!.config/nvim/
!.config/nvim/**
!.config/opencode/
!.config/opencode/**
!.config/openspec/
!.config/openspec/**
!.config/wezterm/
!.config/wezterm/**

# Top-level config files
!.config/starship.toml

# --- .glzr configuration (all customization) ---
!.glzr/
!.glzr/**

# --- top-level dotfiles ---
!.gitconfig

# --- exclude runtime/cache/logs/save data within included dirs ---
# Logs
*.log
**/logs/
**/logs/**
# Cache / auth / registry
.auth.db*
**/registry/
**/registry/**
# Game save / replay data (YourOnlyMoveIsHUSTLE)
.config/YourOnlyMoveIsHUSTLE/replay/
.config/YourOnlyMoveIsHUSTLE/replay/**
.config/YourOnlyMoveIsHUSTLE/playerdata.json
.config/YourOnlyMoveIsHUSTLE/modded.json
# Shell history (not a config file)
.bash_history
